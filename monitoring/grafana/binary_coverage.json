     "query": "SELECT * FROM (SELECT last(\"coverage_pct\") AS \"coverage\", last(\"prev_pct\") AS \"previous\", last(\"delta_pct\") AS \"change (pp)\", last(\"delta_total\") AS \"dfunc\", last(\"total_functions\") AS \"functions\", last(\"called_functions\") AS \"covered\", last(\"new_image\") AS \"new\" FROM \"binary_coverage_image\" WHERE \"instance\" = 'o3' AND \"job_id\" = $latest_job GROUP BY \"image\") WHERE \"change (pp)\" != 0 OR \"new\" = 1"
